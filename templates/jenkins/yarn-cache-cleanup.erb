#!/bin/bash

set -u

config_file='/etc/default/jenkins-swarm-client'
password_file='/etc/jenkins-swarm-client/password'
cache_dir='<%= @data_dir %>/.cache/yarn'
attempts=5
delay=600

log() {
  echo "$(date --iso-8601=seconds) $*"
}

if [[ ! -r "${config_file}" ]]; then
  log "Missing ${config_file}; skipping cleanup"
  exit 1
fi

if [[ ! -r "${password_file}" ]]; then
  log "Missing ${password_file}; skipping cleanup"
  exit 1
fi

# shellcheck source=/dev/null
source "${config_file}"

if [[ -z "${JENKINS_USER:-}" || -z "${CONTROLLER_URL:-}" ]]; then
  log "Missing JENKINS_USER or CONTROLLER_URL in ${config_file}; skipping cleanup"
  exit 1
fi

JENKINS_PASSWORD="$(cat "${password_file}")"
controller_url="${CONTROLLER_URL%/}"
node_names=("$(hostname -s)" "$(hostname -f)")

running_builds() {
  local node_name="$1"
  local response
  local url

  url="${controller_url}/computer/${node_name}/api/json?tree=executors[currentExecutable[url]],oneOffExecutors[currentExecutable[url]]"

  response="$(curl -gfsS -u "${JENKINS_USER}:${JENKINS_PASSWORD}" "${url}" 2>/dev/null)" || return 2

  jq '[.executors[]?, .oneOffExecutors[]?] | map(select(.currentExecutable != null)) | length' <<< "${response}"
}

for attempt in $(seq 1 "${attempts}"); do
  checked=false

  for node_name in "${node_names[@]}"; do
    running_count="$(running_builds "${node_name}")"
    status=$?

    if [[ "${status}" -ne 0 ]]; then
      continue
    fi

    checked=true

    if [[ "${running_count}" -eq 0 ]]; then
      if [[ -d "${cache_dir}" ]]; then
        log "No running builds on ${node_name}; cleaning ${cache_dir}"
        find "${cache_dir}" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
      else
        log "${cache_dir} does not exist; nothing to clean"
      fi

      exit 0
    fi

    log "${running_count} running build(s) on ${node_name}; cleanup postponed"
    break
  done

  if [[ "${checked}" == false ]]; then
    log "Could not determine Jenkins executor state"
  fi

  if [[ "${attempt}" -lt "${attempts}" ]]; then
    sleep "${delay}"
  fi
done

log "Jenkins node stayed busy or unavailable after ${attempts} attempts; skipping cleanup"
exit 1
