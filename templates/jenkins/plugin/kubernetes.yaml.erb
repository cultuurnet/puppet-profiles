jenkins:
  clouds:
  - kubernetes:
      containerCap: 10
      containerCapStr: "10"
      credentialsId: "<%= @configuration['credentials_id'] %>"
      defaultsProviderTemplate: "eks-agent"
      name: "ops-tooling"
      namespace: "jenkins"
      serverCertificate: ""
      serverUrl: "https://AA0165DEF462E7E9E31739D536C3C87C.gr7.eu-west-1.eks.amazonaws.com"
      templates:
<% [
  ['eks-agent', '2Gi', '516a7c97-fb02-4302-905f-a945f894fc4c'],
  ['eks-agent-4g', '4Gi', '96d23bf8-f498-407c-821f-c76087f98238'],
  ['eks-agent-12g', '12Gi', '7665b941-ecf7-461d-a6da-bec497a81850']
].each do |agent_name, memory, id| %>
      - agentInjection: true
        namespace: "jenkins"
        serviceAccount: "jenkins-agent"
        containers:
        - args: "9999999"
          command: "sleep"
          envVars:
          - envVar:
              key: "DOCKER_HOST"
              value: "tcp://localhost:2375"
          image: "<%= @configuration['jnlp_image'] %>"
          resourceRequestMemory: "<%= memory %>"
          resourceLimitMemory: "<%= memory %>"
          livenessProbe:
            failureThreshold: 0
            initialDelaySeconds: 0
            periodSeconds: 0
            successThreshold: 0
            timeoutSeconds: 0
          name: "jnlp"
          workingDir: "/home/jenkins/agent"
        - args: "--host=tcp://0.0.0.0:2375 --host=unix:///var/run/docker.sock"
          command: "dockerd"
          envVars:
          - envVar:
              key: "DOCKER_TLS_CERTDIR"
          image: "docker.io/docker:29.9.0-dind"
          livenessProbe:
            failureThreshold: 0
            initialDelaySeconds: 0
            periodSeconds: 0
            successThreshold: 0
            timeoutSeconds: 0
          name: "dind"
          privileged: true
          workingDir: "/home/jenkins/agent"
        id: "<%= id %>"
        label: "<%= agent_name %>"
        name: "<%= agent_name %>"
        yaml: |
          apiVersion: v1
          kind: Pod
          spec:
            nodeSelector:
              workload: jenkins-agents
            tolerations:
            - key: jenkins-agents
              operator: Equal
              value: "true"
              effect: NoSchedule
            containers:
            - name: dind
              readinessProbe:
                exec:
                  command:
                  - docker
                  - -H
                  - tcp://127.0.0.1:2375
                  - info
                periodSeconds: 2
                timeoutSeconds: 2
        yamlMergeStrategy: "override"
<% end %>
      webSocket: true
