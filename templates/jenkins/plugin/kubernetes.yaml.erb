jenkins:
  clouds:
  - kubernetes:
      containerCap: 10
      containerCapStr: "10"
      credentialsId: "<%= @configuration['credentials_id'] %>"
      defaultsProviderTemplate: "eks-agent"
      name: "publiq-testing-eks"
      serverCertificate: ""
      serverUrl: "https://2C0F8CFEE04395831F893A8FF6558D95.gr7.eu-west-1.eks.amazonaws.com"
      templates:
      - agentInjection: true
        containers:
        - args: "9999999"
          command: "sleep"
          envVars:
          - envVar:
              key: "DOCKER_HOST"
              value: " tcp://localhost:2375"
          image: "<%= @configuration['jnlp_image'] %>"
          livenessProbe:
            failureThreshold: 0
            initialDelaySeconds: 0
            periodSeconds: 0
            successThreshold: 0
            timeoutSeconds: 0
          name: "jnlp"
          workingDir: "/home/jenkins/agent"
        - args: "--host=tcp://0.0.0.0:2375 --host=unix:///var/run/docker.sock"
          command: "dockerd"
          envVars:
          - envVar:
              key: "DOCKER_TLS_CERTDIR"
          image: "docker.io/docker:29.9.0-dind"
          livenessProbe:
            failureThreshold: 0
            initialDelaySeconds: 0
            periodSeconds: 0
            successThreshold: 0
            timeoutSeconds: 0
          name: "dind"
          privileged: true
          workingDir: "/home/jenkins/agent"
        id: "516a7c97-fb02-4302-905f-a945f894fc4c"
        label: "eks-agent"
        name: "eks-agent"
        yamlMergeStrategy: "override"
      webSocket: true
