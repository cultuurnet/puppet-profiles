HOST=<%= @service_address %>
PORT=<%= @service_port %>
NODE_OPTIONS=--max_old_space_size=<%= @maximum_heap_size %>
NUXT_TELEMETRY_DISABLED=1
<%- if @newrelic_license_key -%>
NEW_RELIC_LICENSE_KEY=<%= @newrelic_license_key %>
NEW_RELIC_APP_NAME=<%= @newrelic_app_name %>
NEW_RELIC_TRACER_ENABLED=<%= @newrelic_tracing %>
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=<%= @newrelic_tracing %>
NEW_RELIC_TRANSACTION_EVENTS_ENABLED=false
NEW_RELIC_OPENTELEMETRY_ENABLED=<%= @newrelic_opentelemetry %>
OTEL_SERVICE_NAME=<%= @newrelic_app_name %>
OTEL_EXPORTER_OTLP_ENDPOINT= https://otlp.eu01.nr-data.net
OTEL_EXPORTER_OTLP_HEADERS=api-key=<%= @newrelic_license_key %>
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=4095
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
<%- end -%>
