# MemoryCurrent covers the whole cgroup while --max_old_space_size applies per
# worker, so the ceiling scales with the worker count.
current_memory_mb=$(( $(/usr/bin/systemctl show -p MemoryCurrent --value ${SERVICE}) / (1024 * 1024) ))
maximum_memory_mb=$(( <%= @maximum_heap_size %> * <%= @cluster_workers %> * 9 / 10 ))

/usr/bin/test ${current_memory_mb} -lt ${maximum_memory_mb}
