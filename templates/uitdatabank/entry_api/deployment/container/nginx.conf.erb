server {
    listen 127.0.0.1:8080;

    root /var/www/html/web;

    # Every request reaching nginx has already passed through the native Apache reverse proxy, whose access logs are shipped by filebeat.
    # Logging here would duplicate that record
    #
    # Re-enable this when Apache is removed from in front of the container: at
    # that point nginx becomes the only access log, and it needs its own
    # `logging:` block in docker-compose.yml.erb sized for the request volume
    access_log off;

    # Kept on: nginx error/warning output is not duplicated anywhere else.
    error_log /dev/stderr warn;

    # Apache did not limit request bodies; PHP's post_max_size still does
    client_max_body_size 0;

    # Files under web/ (JSON-LD contexts, test files, exports in downloads/) are
    # served from disk, everything else goes to the front controller, which is
    # what web/.htaccess does under Apache
    location / {
        try_files $uri /index.php$is_args$args;
    }

    # Ubuntu's mime types map .jsonld to application/ld+json, nginx's have no entry for it
    location ~ \.jsonld$ {
        default_type application/ld+json;
        try_files $uri /index.php$is_args$args;
    }

    location ~ /\.ht {
        deny all;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/html/web/index.php;
        # Same as Apache's Timeout, exports and imports can take a while
        fastcgi_read_timeout 300;
    }
}
