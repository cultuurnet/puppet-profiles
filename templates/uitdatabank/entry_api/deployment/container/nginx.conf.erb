# Mirrors udb3-backend's own docker/nginx.conf, with three changes for running as
# a sidecar: it listens on loopback for Apache to reverse proxy to, reaches
# php-fpm over the network namespace it shares with the entry-api container, and
# leaves access logging to Apache.
server {
    listen 127.0.0.1:8080;

    root /var/www/html/web;
    index index.php;

    # Every request reaching nginx already passed through Apache, whose access log
    # filebeat ships. This inverts once Apache is removed: nginx becomes the only
    # access log and needs its own logging: block sized for real traffic.
    access_log off;

    # web/testfiles, web/uploads and web/downloads are served straight from disk —
    # the acceptance tests fetch image and export URLs over HTTP. Everything else
    # goes to the front controller, which is what web/.htaccess does under Apache.
    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/html/web/index.php;
        # Exports and imports outlast nginx's 60s default
        fastcgi_read_timeout 300;
    }

    # Image uploads: nginx caps request bodies at 1m by default, Apache did not cap
    # them at all
    client_max_body_size 100m;
}
