# nginx serves web/ from the entry-api-web volume, which entry-web-assets fills
# from the image on every `up`. A new image tag rewrites this file, so the
# stack is recreated and the copy runs again, keeping web/ in step with the image.
volumes:
  entry-api-web:

x-entry-api: &entry-api
  image: <%= @ecr_registry %>/<%= @ecr_repository %>:<%= @image_tag %>
  network_mode: host
  restart: unless-stopped
  environment:
    LOG_TO_STDOUT: "true"
  volumes:
<%- ['config.php', 'config.allow_all.php', 'config.client_permissions.php', 'config.kinepolis.php', 'config.completeness.php', 'config.external_id_mapping_organizer.php', 'config.external_id_mapping_place.php', 'public.pem', 'public-keycloak.pem'].each do |file| -%>
    - <%= @config_dir %>/<%= file %>:/var/www/html/<%= file %>:ro
<%- end -%>
<%- if @api_keys_matched_to_client_ids -%>
    - <%= @config_dir %>/config.api_keys_matched_to_client_ids.php:/var/www/html/config.api_keys_matched_to_client_ids.php:ro
<%- end -%>
    - <%= @config_dir %>/fpm-pool.conf:/usr/local/etc/php-fpm.d/zz-pool.conf:ro
    - <%= @downloads_dir %>:/var/www/html/web/downloads

# Same command, working directory and environment as the systemd units of the
# instance deployment
x-resque-worker: &resque-worker
  <<: *entry-api
  working_dir: /var/www/html/vendor/chrisboulton/php-resque
  command: ["php", "resque.php"]
  environment: &resque-worker-environment
    LOG_TO_STDOUT: "true"
    APP_INCLUDE: /var/www/html/worker_bootstrap.php
    INTERVAL: "1"

services:
  entry-web-assets:
    image: <%= @ecr_registry %>/<%= @ecr_repository %>:<%= @image_tag %>
    restart: "no"
    # The volume is created root-owned, the image runs as www-data
    user: "0:0"
    command: ["cp", "-a", "/var/www/html/web/.", "/srv/web/"]
    volumes:
      - entry-api-web:/srv/web

  entry-api:
    <<: *entry-api
    healthcheck:
      test: ["CMD-SHELL", "nc -z 127.0.0.1 9000 || exit 1"]
      start_period: 10s
      interval: 10s
      timeout: 5s
      retries: 3

  entry-nginx:
    image: nginx:1.31.9-alpine
    restart: unless-stopped
    network_mode: "service:entry-api"
    volumes:
      - <%= @config_dir %>/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - entry-api-web:/var/www/html/web:ro
      - <%= @downloads_dir %>:/var/www/html/web/downloads:ro
    depends_on:
      entry-api:
        condition: service_healthy
      entry-web-assets:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://127.0.0.1:8080/api/context/event.jsonld || exit 1"]
      start_period: 10s
      interval: 10s
      timeout: 5s
      retries: 3
<%- if @bulk_label_offer_worker == 'present' -%>

  bulk-label-offer-worker:
    <<: *resque-worker
    environment:
      <<: *resque-worker-environment
      QUEUE: bulk_label_offer
<%- end -%>
<%- if @mail_worker == 'present' -%>

  mail-worker:
    <<: *resque-worker
    environment:
      <<: *resque-worker-environment
      QUEUE: mails
<%- end -%>
<%- if @event_export_worker_count > 0 -%>

  event-export-worker:
    <<: *resque-worker
    environment:
      <<: *resque-worker-environment
      QUEUE: event_export
    stop_grace_period: 900s
    scale: <%= @event_export_worker_count %>
<%- end -%>
<%- if @amqp_listener_uitpas == 'present' -%>

  amqp-listener-uitpas:
    <<: *entry-api
    # bin/udb3.php sets API_NAME from this exact command name
    command: ["php", "bin/udb3.php", "amqp-listen-uitpas"]
<%- end -%>
